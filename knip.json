{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/build.js"],
      "project": ["scripts/**/*.js"]
    },
    "packages/build": {
      "entry": ["src/build.ts", "src/computeNodeModulesCacheKey.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/e2e": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/memory": {
      "entry": ["src/measureMemory.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/package-extension": {
      "entry": ["src/main.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
