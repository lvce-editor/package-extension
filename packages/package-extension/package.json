{
  "name": "@lvce-editor/package-extension",
  "version": "0.0.0-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvce-editor/package-extension.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "src/main.ts",
  "types": "src/main.d.ts",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "jest": {
    "injectGlobals": false,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "testMatch": [
      "**/test/**"
    ],
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 85,
        "lines": 80
      }
    }
  },
  "dependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@lvce-editor/verror": "^1.7.0",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "execa": "^9.6.1",
    "rollup": "^4.53.3",
    "tar-fs": "^3.1.1"
  },
  "devDependencies": {
    "@types/tar-fs": "^2.0.4",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6"
  }
}
