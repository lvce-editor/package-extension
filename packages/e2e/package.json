{
  "name": "@lvce-editor/e2e",
  "version": "0.0.0-dev",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "jest": {
    "injectGlobals": false,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "testMatch": [
      "<rootDir>/test/**"
    ]
  },
  "dependencies": {
    "execa": "^9.6.1",
    "tar-fs": "^3.1.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/node": "^25.0.1",
    "@types/tar-fs": "^2.0.4",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6"
  }
}
