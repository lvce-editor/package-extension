{
  "name": "@lvce-editor/package-extension-monorepo",
  "version": "0.0.0-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvce-editor/package-extension.git"
  },
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "format": "prettier --write .",
    "postinstall": "lerna bootstrap --ci",
    "lint": "eslint . && prettier --check .",
    "measure": "cd packages/memory && npm run measure",
    "test": "lerna run test",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "devDependencies": {
    "@lerna/legacy-package-management": "^8.2.4",
    "@lvce-editor/eslint-config": "^16.3.0",
    "eslint": "^10.7.0",
    "jest": "^30.2.0",
    "lerna": "^8.2.4",
    "prettier": "^3.7.4",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
