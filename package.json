{
  "name": "@lvce-editor/package-extension-monorepo",
  "version": "0.0.0-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvce-editor/package-extension.git"
  },
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "main": "src/main.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "measure": "cd packages/memory && npm run measure",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^17.1.0",
    "eslint": "^10.7.0",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
